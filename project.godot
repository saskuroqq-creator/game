[application]
config/name="YOKAI: Shadow of Izanami"
config/version="0.2.0-alpha.5"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]
window/vsync/vsync_mode=1
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.driver="opengl3"
renderer/rendering_method.mobile.driver="opengl3"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.015,0.012,0.025,1)

[input]
attack={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
heavy={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
dash={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":16)]}
